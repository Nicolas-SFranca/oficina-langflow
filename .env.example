# URL do Postgres (Neon) com permissão de ler e escrever.
# Ex.: postgresql://usuario:senha@ep-xxx.neon.tech/fakegram?sslmode=require
DATABASE_URL=

# Chave do instrutor. O frontend envia no header X-Admin-Key.
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(24))"
ADMIN_KEY=

# Origens liberadas no CORS, separadas por vírgula.
# Use o endereço do frontend (Lovable ou o Vite local).
CORS_ORIGINS=http://localhost:8080

# URL pública desta API, sem barra no final.
# Serve para montar o endereço do MCP que o grupo cola no Langflow.
PUBLIC_API_URL=http://localhost:8000

# Senha do usuário aluno_leitura, usado no exercício 2.
# O script scripts/migrar.py grava essa senha na role. Não commite o .env.
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(24))"
ALUNO_LEITURA_SENHA=

# Branch testes do Neon. O pytest usa esta URL e nunca o DATABASE_URL da aula.
TEST_DATABASE_URL=

# Connection string somente leitura, com o usuário aluno_leitura e a senha acima.
# Mesmo host e banco do DATABASE_URL. Entra no kit do exercício 2.
# Ex.: postgresql://aluno_leitura:senha@ep-xxx-pooler.neon.tech/neondb?sslmode=require
NEON_READONLY_URL=

# Máximo de ações de um grupo por minuto (REST ou MCP).
LIMITE_ACOES_POR_MINUTO=30

# Máximo de posts que um grupo pode publicar por hora.
LIMITE_POSTS_POR_HORA=5
