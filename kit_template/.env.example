# Modelo do .env deste kit. Copie para .env e preencha o que faltar.
# Nunca publique o .env: ele guarda o token do grupo.

# Fakegram: API e MCP, enquanto a oficina estiver no ar
API_URL={{API_URL}}
MCP_URL={{MCP_URL}}

# Token do grupo, entregue pelo instrutor na aula
TOKEN=
GRUPO=
PERFIL=

# Bônus analista: URL do banco só de leitura, pedida ao instrutor
NEON_RO_URL=

# chamar_fluxo.py: chave do Langflow e id do fluxo (Compartilhar > API access)
# Não coloque aqui nenhuma chave de modelo de IA: ela fica no Langflow.
LANGFLOW_API_KEY=
FLOW_ID=
